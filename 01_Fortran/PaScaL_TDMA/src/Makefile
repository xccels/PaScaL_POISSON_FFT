include ../Makefile.inc

MODE ?= debug
BUILD_FLAGS ?=

LIB = libpascal_tdma.a
OBJDIR = ./obj/$(MODE)
LIBDIR = ../lib/$(MODE)
INCLUDEDIR = ../include/$(MODE)

RANGE = $(OBJDIR)/para_range.o
TDMAS = $(OBJDIR)/tdmas.o
PTDMA = $(OBJDIR)/pascal_tdma.o
TDMAS_CUDA = $(OBJDIR)/tdmas_cuda.o
PTDMA_CUDA = $(OBJDIR)/pascal_tdma_cuda.o

OBJS = $(RANGE) $(TDMAS) $(PTDMA)

ifdef USE_CUDA
    OBJS += $(TDMAS_CUDA) $(PTDMA_CUDA)
endif

all: $(OBJDIR) $(LIBDIR) $(INCLUDEDIR) $(LIBDIR)/$(LIB)

$(OBJDIR):
	mkdir -p $@

$(LIBDIR):
	mkdir -p $@

$(INCLUDEDIR):
	mkdir -p $@

$(LIBDIR)/$(LIB): $(OBJS) | $(LIBDIR) $(INCLUDEDIR)
	ar rcs $@ $(OBJS)
	cp $(OBJDIR)/*.mod $(INCLUDEDIR)/

$(OBJDIR)/%.o: %.f90 | $(OBJDIR)
	$(FC) $(FLAG) $(BUILD_FLAGS) -c $< -o $@ -module $(OBJDIR) -I$(OBJDIR)

$(OBJDIR)/%.o: %.cuf | $(OBJDIR)
	$(FC) $(FLAG) $(BUILD_FLAGS) -c $< -o $@ -module $(OBJDIR) -I$(OBJDIR)

# Fortran module dependency: pascal_tdma_cuda.f90 uses the tdma module
# generated by tdmas_cuda.f90.  This must be explicit for parallel builds.
$(PTDMA_CUDA): $(TDMAS_CUDA)

clean:
	rm -rf ./obj/debug* ./obj/perf*
	rm -rf ../lib/debug* ../lib/perf*
	rm -rf ../include/debug* ../include/perf*

.PHONY: all clean
